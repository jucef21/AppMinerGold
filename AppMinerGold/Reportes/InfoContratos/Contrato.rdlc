          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>PARAGRAFO 1</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#262626</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>.  Si  por  cualquier  motivo  la  empresa receptora del mineral en el exterior no paga la comisión a </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
