              </TextRun>
              <TextRun>
                <Value>CONTRATO  DE  MANDATO  ESPECIAL  SIN  REPRESENTACIÓN</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>8pt</FontSize>
